# ---------------------------------------------------------------------------
# AI Deck — Unity / macOS / Xcode .gitignore
# ---------------------------------------------------------------------------

# Unity generated folders (project is at AIDeckUnity/)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data for files that are ignored
!/[Aa]ssets/**/*.meta

# Never ignore Unity package manifests
!/**/Packages/manifest.json
!/**/Packages/packages-lock.json

# Unity3D generated project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated crash / debug artefacts
sysinfo.txt
crashlytics-build.properties
*.stackdump

# Unity Addressables / burst
/[Aa]ssets/[Ss]treamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
*.burst.debug

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
.gradle/

# Built application output
/build/
/Build/
/dist/
*.app/
*.dmg
*.ipa
*.apk

# Generated Xcode project (regenerated from Unity — see docs/BUILD_IPAD.md)
/build-ios/
/Build/iOS/
*.xcuserdatad/
xcuserdata/
DerivedData/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# AI Deck runtime output (never commit user audio or recordings)
/AIDeckUnity/[Aa]ssets/[Ss]treamingAssets/[Mm]usic/
*.wav.tmp
/sandbox/
/scratch/

# Local AI music generator runtime, model weights and generated validation audio.
# These are reproducible downloads/runtime outputs and can exceed 10 GB.
/.aideck-generator/

# Test / coverage artefacts
/TestResults/
/[Cc]overage[Rr]esults/
*.trx

# Written by the build pipeline on every build; it names the commit, so committing it
# would either be stale or churn on every build.
AIDeckUnity/Assets/Resources/
AIDeckUnity/Assets/Resources.meta
